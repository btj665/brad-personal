# Copy this file to `.env.local` and fill in your Supabase project's values.
# Both are safe to expose in the browser bundle — the database is guarded by
# row-level security, not by keeping these secret. Leave them blank to run the
# app in guest mode (no login, a local play-money wallet). See SETUP.md.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
