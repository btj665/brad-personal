# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Cloudflare Tunnel token (dashboard-managed tunnel).
# Get this from: Cloudflare Zero Trust dashboard -> Networks -> Tunnels ->
#   Create a tunnel -> Cloudflared -> copy the token from the install command
#   (the long string after `--token`).
CLOUDFLARE_TUNNEL_TOKEN=
